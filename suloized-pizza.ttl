suloized-pizza: a owl:Ontology ;
    rdfs:label "Suloized Pizza"@en ;
    dcterms:created "2026-08-20" ;
    dcterms:creator "https://github.com/micheldumontier" ;
    dcterms:description "The community Pizza ontology re-expressed in SULO-canonical form by ontointegrator. Object-property usages are rewritten to SULO relations (hasPart, hasFeature) with exact range guards, recursively through nested class expressions, and imported alongside SULO and PRO. Distinct from the SULO pizza tutorial ontology (https://w3id.org/ontostart/pizza)." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Suloized Pizza" ;
    vann:preferredNamespacePrefix "suloized-pizza" ;
    vann:preferredNamespaceUri "https://w3id.org/ontostart/suloized-pizza/" ;
    rdfs:comment "Release note (recursive expression rewriting): SpicyPizzaEquivalent now carries a full EquivalentClasses SULO definition (Pizza and hasPart some (PizzaTopping and hasFeature some Hot)); named-pizza topping/base restrictions use sulo:hasPart and topping spiciness sulo:hasFeature, with exact range guards so negated contexts (e.g. VegetarianPizza) stay faithful; Spiciness re-parented under sulo:Quality. Additive; validated consistent by rustdl." ;
    owl:imports <https://ontoexplorer.dev.k8s.semanticscience.org/api/v1/ontologies/4e8bd8d2-e9fc-418f-ab92-fb2c727a26fa/b2abd4fb-8d44-4a5f-969d-43b25f1f3844/download>,
        <https://w3id.org/ontostart/pro/>,
        <https://w3id.org/sulo> ;
    owl:versionInfo "0.0.0" .

<http://www.co-ode.org/ontologies/pizza/pizza.owl#FishTopping> rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/sulo/hasFeature> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( <http://www.co-ode.org/ontologies/pizza/pizza.owl#Mild> <http://www.co-ode.org/ontologies/pizza/pizza.owl#Spiciness> ) ] ] .

<http://www.co-ode.org/ontologies/pizza/pizza.owl#Food> rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/sulo/hasPart> ;
            owl:someValuesFrom <http://www.co-ode.org/ontologies/pizza/pizza.owl#Food> ] .

<http://www.co-ode.org/ontologies/pizza/pizza.owl#NutTopping> rdfs:subClassOf [ a owl:Restriction ;
