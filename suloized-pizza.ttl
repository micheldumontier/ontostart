    rdfs:comment "placeholder minted by ontointegrator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/sulo/isFeatureOf> ;
            owl:someValuesFrom <http://www.co-ode.org/ontologies/pizza/pizza.owl#PizzaBase> ],
        <https://w3id.org/ontostart/pro/ContainmentRole>,
        <https://w3id.org/ontostart/pro/PartRole> .

<http://www.co-ode.org/ontologies/pizza/pizza.owl#PizzaCompositionProcess> a owl:Class ;
    rdfs:comment "placeholder minted by ontointegrator" ;
