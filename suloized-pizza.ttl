            owl:onProperty <https://w3id.org/sulo/hasParticipant> ;
            owl:someValuesFrom <http://www.co-ode.org/ontologies/pizza/pizza.owl#PizzaToppingRole> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/sulo/hasParticipant> ;
            owl:someValuesFrom <http://www.co-ode.org/ontologies/pizza/pizza.owl#PizzaBaseRole> ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/sulo/hasParticipant> ;
            owl:someValuesFrom <http://www.co-ode.org/ontologies/pizza/pizza.owl#PizzaWholeRole> ],
        <https://w3id.org/ontostart/pro/TransformationProcess> .

<http://www.co-ode.org/ontologies/pizza/pizza.owl#PizzaToppingRole> a owl:Class ;
    rdfs:comment "placeholder minted by ontointegrator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/sulo/isFeatureOf> ;
            owl:someValuesFrom <http://www.co-ode.org/ontologies/pizza/pizza.owl#PizzaTopping> ],
        <https://w3id.org/ontostart/pro/OnTopPositionRole>,
        <https://w3id.org/ontostart/pro/PartRole> .

<http://www.co-ode.org/ontologies/pizza/pizza.owl#PizzaWholeRole> a owl:Class ;
    rdfs:comment "placeholder minted by ontointegrator" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/sulo/isFeatureOf> ;
            owl:someValuesFrom <http://www.co-ode.org/ontologies/pizza/pizza.owl#Pizza> ],
        <https://w3id.org/ontostart/pro/WholeRole> .

<http://www.co-ode.org/ontologies/pizza/pizza.owl#SpicyTopping> owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.co-ode.org/ontologies/pizza/pizza.owl#PizzaTopping> [ a owl:Restriction ;
                        owl:onProperty <https://w3id.org/sulo/hasFeature> ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <http://www.co-ode.org/ontologies/pizza/pizza.owl#Hot> <http://www.co-ode.org/ontologies/pizza/pizza.owl#Spiciness> ) ] ] ) ] .

<http://www.co-ode.org/ontologies/pizza/pizza.owl#ArtichokeTopping> rdfs:subClassOf [ a owl:Restriction ;
