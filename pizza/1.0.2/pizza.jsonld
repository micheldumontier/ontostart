      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "Spiciness is a quality that represents the perceived heat or pungency of a food material."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "spiciness"
