    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-19T07:37:38.845348+00:00</dcterms:created>
    <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An OWL ontology for the pizza domain, built incrementally through the SULO Pizza Tutorial. Covers spatial composition, qualities, quantities, processes, information entities, time, and spatial containment.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-19</dcterms:issued>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://lexvo.org/id/iso639-1/en</dcterms:language>
    <dcterms:license rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://creativecommons.org/licenses/by/4.0/</dcterms:license>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-19T07:37:38.845348+00:00</dcterms:modified>
    <dcterms:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://github.com/micheldumontier</dcterms:publisher>
    <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SULO Pizza Tutorial Ontology</dcterms:title>
    <pav:authoredBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0000-0000-0000</pav:authoredBy>
    <vann:preferredNamespacePrefix rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pizza</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ontostart/pizza/</vann:preferredNamespaceUri>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An OWL ontology for the pizza domain, built incrementally through the SULO Pizza Tutorial. Covers spatial composition, qualities, quantities, processes, information entities, time, and spatial containment.</rdfs:comment>
    <owl:imports rdf:resource="https://w3id.org/ontostart/pro"/>
    <owl:imports rdf:resource="https://w3id.org/sulo"/>
    <owl:versionIRI rdf:resource="https://w3id.org/ontostart/pizza/1.0.1"/>
