  <rdf:Description rdf:about="https://w3id.org/ontostart/pizza/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SULO Pizza Tutorial Ontology</rdfs:label>
    <dc:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0000-0000-0000</dc:creator>
    <dcterms:alternative rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pizza</dcterms:alternative>
