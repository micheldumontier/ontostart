    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "A pizza is a food material minimally consisting of a pizza crust (baked dough) and optionally topped with \n                    tomatoes or tomato sauce, cheese, and often various other ingredients (such as anchovies, mushrooms, onions, olives, \n                    vegetables, meat, etc.) baked at a high temperature."
      }
    ],
