  <rdf:Description rdf:about="https://w3id.org/ontostart/pizza/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SULO Pizza Tutorial Ontology</rdfs:label>
    <dc:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0000-0000-0000</dc:creator>
    <dcterms:alternative rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pizza</dcterms:alternative>
    <dcterms:bibliographicCitation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unpublished</dcterms:bibliographicCitation>
    <dcterms:contributor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0000-0000-0000</dcterms:contributor>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-12T18:58:29.971347+00:00</dcterms:created>
    <dcterms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An OWL ontology for the pizza domain, built incrementally through the SULO Pizza Tutorial. Covers spatial composition, qualities, quantities, processes, information entities, time, and spatial containment.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-12</dcterms:issued>
    <dcterms:language rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://lexvo.org/id/iso639-1/en</dcterms:language>
    <dcterms:license rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://creativecommons.org/licenses/by/4.0/</dcterms:license>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-12T18:58:29.971347+00:00</dcterms:modified>
    <dcterms:publisher rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://github.com/micheldumontier</dcterms:publisher>
    <dcterms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SULO Pizza Tutorial Ontology</dcterms:title>
    <pav:authoredBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0000-0000-0000</pav:authoredBy>
    <vann:preferredNamespacePrefix rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pizza</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ontostart/pizza/</vann:preferredNamespaceUri>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An OWL ontology for the pizza domain, built incrementally through the SULO Pizza Tutorial. Covers spatial composition, qualities, quantities, processes, information entities, time, and spatial containment.</rdfs:comment>
    <owl:backwardCompatibleWith rdf:resource="https://w3id.org/ontostart/pizza/1.0.1"/>
    <owl:imports rdf:resource="https://w3id.org/ontostart/pro"/>
    <owl:imports rdf:resource="https://w3id.org/sulo"/>
    <owl:priorVersion rdf:resource="https://w3id.org/ontostart/pizza/1.0.1"/>
    <owl:versionIRI rdf:resource="https://w3id.org/ontostart/pizza/1.0.2"/>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0.2</owl:versionInfo>
    <dcat:accessURL rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://w3id.org/ontostart/pizza/</dcat:accessURL>
    <foaf:homepage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://github.com/micheldumontier/ontostart</foaf:homepage>
    <mod:definitionProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.w3.org/2000/01/rdf-schema#comment</mod:definitionProperty>
    <mod:hasRepresentationLanguage rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://omv.ontoware.org/2005/05/ontology#OWL</mod:hasRepresentationLanguage>
    <mod:hasSyntax rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.w3.org/ns/formats/Turtle</mod:hasSyntax>
    <mod:prefLabelProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.w3.org/2000/01/rdf-schema#label</mod:prefLabelProperty>
    <mod:status rdf:datatype="http://www.w3.org/2001/XMLSchema#string">active</mod:status>
