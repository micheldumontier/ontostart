  <rdf:Description rdf:about="https://w3id.org/ontostart/suloized-pizza/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Suloized Pizza</rdfs:label>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-12T18:42:07.566202+00:00</dcterms:created>
    <dcterms:creator>https://github.com/micheldumontier</dcterms:creator>
    <dcterms:description>The community Pizza ontology re-expressed in SULO-canonical form by ontointegrator. Object-property usages are rewritten to SULO relations (hasPart, hasFeature) with exact range guards, recursively through nested class expressions, and imported alongside SULO and PRO. Distinct from the SULO pizza tutorial ontology (https://w3id.org/ontostart/pizza).</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-12</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-11-12T18:42:07.566202+00:00</dcterms:modified>
    <dcterms:title>Suloized Pizza</dcterms:title>
    <vann:preferredNamespacePrefix>suloized-pizza</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/ontostart/suloized-pizza/</vann:preferredNamespaceUri>
    <rdfs:comment>Release note (recursive expression rewriting): SpicyPizzaEquivalent now carries a full EquivalentClasses SULO definition (Pizza and hasPart some (PizzaTopping and hasFeature some Hot)); named-pizza topping/base restrictions use sulo:hasPart and topping spiciness sulo:hasFeature, with exact range guards so negated contexts (e.g. VegetarianPizza) stay faithful; Spiciness re-parented under sulo:Quality. Additive; validated consistent by rustdl.</rdfs:comment>
    <owl:backwardCompatibleWith rdf:resource="https://w3id.org/ontostart/suloized-pizza/0.0.1"/>
    <owl:imports rdf:resource="https://protege.stanford.edu/ontologies/pizza/pizza.owl"/>
    <owl:imports rdf:resource="https://w3id.org/ontostart/pro/"/>
    <owl:imports rdf:resource="https://w3id.org/sulo"/>
    <owl:priorVersion rdf:resource="https://w3id.org/ontostart/suloized-pizza/0.0.1"/>
    <owl:versionIRI rdf:resource="https://w3id.org/ontostart/suloized-pizza/0.0.2"/>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0.0.2</owl:versionInfo>
  </rdf:Description>
