  {
    "@id": "https://w3id.org/ontostart/suloized-pizza/",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#dateTime",
        "@value": "2026-08-20T09:09:03.574228+00:00"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "https://github.com/micheldumontier"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "The community Pizza ontology re-expressed in SULO-canonical form by ontointegrator. Object-property usages are rewritten to SULO relations (hasPart, hasFeature) with exact range guards, recursively through nested class expressions, and imported alongside SULO and PRO. Distinct from the SULO pizza tutorial ontology (https://w3id.org/ontostart/pizza)."
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-08-20"
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#dateTime",
        "@value": "2026-08-20T09:09:03.574228+00:00"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@value": "Suloized Pizza"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "suloized-pizza"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://w3id.org/ontostart/suloized-pizza/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Release note (recursive expression rewriting): SpicyPizzaEquivalent now carries a full EquivalentClasses SULO definition (Pizza and hasPart some (PizzaTopping and hasFeature some Hot)); named-pizza topping/base restrictions use sulo:hasPart and topping spiciness sulo:hasFeature, with exact range guards so negated contexts (e.g. VegetarianPizza) stay faithful; Spiciness re-parented under sulo:Quality. Additive; validated consistent by rustdl."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Suloized Pizza"
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "https://ontoexplorer.dev.k8s.semanticscience.org/api/v1/ontologies/4e8bd8d2-e9fc-418f-ab92-fb2c727a26fa/b2abd4fb-8d44-4a5f-969d-43b25f1f3844/download"
      },
      {
        "@id": "https://w3id.org/ontostart/pro/"
      },
      {
        "@id": "https://w3id.org/sulo"
      }
    ],
