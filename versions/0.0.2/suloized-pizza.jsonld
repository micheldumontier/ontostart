    "http://purl.org/dc/terms/creator": [
      {
        "@value": "https://github.com/micheldumontier"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "The community Pizza ontology re-expressed in SULO-canonical form by ontointegrator. Object-property usages are rewritten to SULO relations (hasPart, hasFeature) with exact range guards, recursively through nested class expressions, and imported alongside SULO and PRO. Distinct from the SULO pizza tutorial ontology (https://w3id.org/ontostart/pizza)."
      }
    ],
